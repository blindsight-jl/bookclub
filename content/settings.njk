---
layout: layouts/base.njk
title: Profile Settings
---
<div class="page-header">
	<p class="page-kicker">Make it yours</p>
	<h1>Your profile</h1>
	<p class="page-description">Choose the name your fellow Buchfreundis will see beside your comments.</p>
</div>

{%- if supabase.url %}
<form id="settings-form" class="auth-form">
	<p id="settings-feedback"></p>
	<div class="field">
		<label for="display-name">Display name</label>
		<input type="text" id="display-name" autocomplete="name" required>
	</div>
	<button type="submit" class="btn-primary">Save</button>
</form>
<script type="module" src="/js/settings.js"></script>
{%- else %}
<p>Settings unavailable.</p>
{%- endif %}
